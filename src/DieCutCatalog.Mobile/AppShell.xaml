<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="DieCutCatalog.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:DieCutCatalog.Mobile.Views"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarTitleColor="#2F5F92"
       Shell.TabBarUnselectedColor="#616161">
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />
    <TabBar Route="main">
        <ShellContent Title="Каталог" Route="catalog" ContentTemplate="{DataTemplate views:CatalogPage}" />
        <ShellContent Title="Профиль" Route="profile" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>
</Shell>