<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="DieCutCatalog.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:DieCutCatalog.Mobile.Views"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="main" ContentTemplate="{DataTemplate views:CatalogPage}" />
</Shell>
