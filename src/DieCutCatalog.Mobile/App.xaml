<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DieCutCatalog.Mobile.App">
    <Application.Resources>
        <Color x:Key="BrandBlue">#2F5F92</Color>
        <Color x:Key="BrandRed">#ED1C24</Color>
        <Color x:Key="TextPrimary">#1F1F1F</Color>
        <Color x:Key="TextSecondary">#616161</Color>
        <Color x:Key="Divider">#E1E5EA</Color>
        <Color x:Key="SurfaceMuted">#F7F8FA</Color>
        <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="White" /></Style>
        <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource TextPrimary}" /><Setter Property="FontFamily" Value="OpenSansRegular" /></Style>
        <Style TargetType="Entry"><Setter Property="BackgroundColor" Value="White" /><Setter Property="TextColor" Value="{StaticResource TextPrimary}" /></Style>
        <Style TargetType="Button"><Setter Property="CornerRadius" Value="5" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="MinimumHeightRequest" Value="48" /></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource BrandBlue}" /><Setter Property="TextColor" Value="White" /></Style>
        <Style x:Key="SectionTitle" TargetType="Label"><Setter Property="FontSize" Value="17" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="TextColor" Value="{StaticResource BrandBlue}" /></Style>
        <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="FontSize" Value="12" /><Setter Property="TextColor" Value="{StaticResource TextSecondary}" /></Style>
    </Application.Resources>
</Application>