<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="DieCutCatalog.Mobile.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.TabBarIsVisible="False">
    <Grid Padding="28,42,28,28" RowDefinitions="Auto,*,Auto">
        <HorizontalStackLayout Spacing="14">
            <Image Source="flexprint_logo.png" WidthRequest="58" HeightRequest="58" />
            <Label Text="DieCut Catalog" FontSize="20" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="14" VerticalOptions="Center">
            <Label Text="Вход в систему" FontSize="28" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" Margin="0,0,0,28" />
            <Label Text="Электронная почта" Style="{StaticResource FieldLabel}" />
            <Border Stroke="{StaticResource Divider}" StrokeShape="RoundRectangle 5" Padding="12,2">
                <Entry x:Name="EmailEntry" Placeholder="user@example.com" Keyboard="Email" />
            </Border>
            <Label Text="Пароль" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
            <Border Stroke="{StaticResource Divider}" StrokeShape="RoundRectangle 5" Padding="12,2">
                <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True" />
            </Border>
            <Button Text="Войти" Style="{StaticResource PrimaryButton}" Margin="0,30,0,0" Clicked="Login_Clicked" />
        </VerticalStackLayout>
        <Label Grid.Row="2" Text="diecutcatalog.duckdns.org" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>