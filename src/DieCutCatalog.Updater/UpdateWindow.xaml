<Window x:Class="DieCutCatalog.Updater.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление DieCut Catalog"
        Width="540" Height="290"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F8FA"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Обновление приложения" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,6,0,0" Foreground="#616161" />
        <Grid Grid.Row="2" Margin="0,26,0,0">
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100"
                         Foreground="#0F6CBD" Background="#E1E5EA" />
            <TextBlock x:Name="PercentageText" Margin="0,18,0,0" HorizontalAlignment="Right"
                       VerticalAlignment="Top" FontWeight="SemiBold" Text="0 %" />
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,34,0,0" TextWrapping="Wrap"
                   Text="Подготовка обновления..." />
        <Button x:Name="CloseButton" Grid.Row="4" Width="110" Height="34"
                HorizontalAlignment="Right" Content="Закрыть" Visibility="Collapsed"
                Click="CloseButton_Click" />
    </Grid>
</Window>
