<ui:FluentWindow x:Class="DieCutCatalog.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:DieCutCatalog.Desktop.Views"
                 Title="Каталог вырубных ножей"
                 Width="1500" Height="900" MinWidth="1250" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="14"
                 Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Каталог вырубных ножей">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Database20" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid x:Name="LoginView" Grid.Row="1" Background="#ECF5F5F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="32" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="8" Background="#0F6B56">
                        <ui:SymbolIcon Symbol="Database24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,20,0,0" Text="Вход в систему" Style="{StaticResource PageTitle}" />
                    <TextBlock Margin="0,6,0,10" Text="Каталог вырубных ножей" Style="{StaticResource CaptionText}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Адрес сервера" />
                    <TextBox x:Name="ServerAddressBox" Text="http://localhost:5080" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Электронная почта" />
                    <TextBox x:Name="EmailBox" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Пароль" />
                    <PasswordBox x:Name="PasswordBox" KeyDown="LoginPassword_KeyDown" />

                    <TextBlock x:Name="LoginError" Margin="0,12,0,0" Foreground="{StaticResource ErrorTextBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ui:Button x:Name="LoginButton" Margin="0,20,0,0" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Appearance="Primary" Content="Войти" Click="Login_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Key20" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ShellView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource NavigationBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16,12,14">
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="10" CornerRadius="8" Background="#0A000000">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="#DCE9E6">
                                <ui:SymbolIcon Symbol="Person20" Foreground="#0F6B56" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SidebarUserName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SidebarUserEmail" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" Width="32" Height="32" Padding="0" Appearance="Transparent"
                                       ToolTip="Выйти" Click="Logout_Click">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="SignOut20" /></ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,2,8,22">
                            <Border Width="32" Height="32" CornerRadius="6" Background="#0F6B56">
                                <ui:SymbolIcon Symbol="Database20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DieCut Catalog" FontWeight="SemiBold" />
                                <TextBlock Text="Производственный учёт" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <ui:Button x:Name="CatalogNavButton" Height="42" Margin="0,0,0,4" Padding="12,0"
                                   Appearance="Primary" Content="Каталог ножей" HorizontalContentAlignment="Left"
                                   Click="ShowCatalog_Click">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Database20" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="EmployeeNavButton" Height="42" Padding="12,0"
                                   Appearance="Transparent" Content="Сотрудник" HorizontalContentAlignment="Left"
                                   Click="ShowEmployee_Click">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Person20" /></ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <views:CatalogView x:Name="CatalogView" />

                <ScrollViewer x:Name="EmployeeView" Margin="28,22,28,24" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                        <TextBlock Text="Сотрудник" Style="{StaticResource PageTitle}" />
                        <TextBlock Margin="0,5,0,0" Text="Профиль, контактные данные и параметры учётной записи"
                                   Style="{StaticResource CaptionText}" />

                        <Border Margin="0,20,0,0" Padding="24" Style="{StaticResource SurfaceCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Border Width="116" Height="116" CornerRadius="8" Background="{StaticResource SurfaceMutedBrush}"
                                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <ui:SymbolIcon Symbol="Person32" Foreground="#9B9B9B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image x:Name="ProfilePhoto" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <ui:Button Margin="0,12,16,0" Appearance="Secondary" Content="Выбрать фото"
                                                   HorizontalAlignment="Stretch" Click="UploadPhoto_Click">
                                            <ui:Button.Icon><ui:SymbolIcon Symbol="ImageAdd20" /></ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>

                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Имя" /><TextBox x:Name="FirstNameBox" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Должность" /><TextBox x:Name="PositionBox" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Телефон" /><TextBox x:Name="PhoneBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Фамилия" /><TextBox x:Name="LastNameBox" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Электронная почта" />
                                            <TextBox x:Name="ProfileEmailBox" Style="{StaticResource ReadOnlyTextBox}" />
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Дополнительные контакты" /><TextBox x:Name="ContactsBox" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    <TextBlock x:Name="ProfileStatus" VerticalAlignment="Center" Margin="0,0,16,0"
                                               Foreground="{StaticResource SuccessTextBrush}" />
                                    <ui:Button Appearance="Primary" Content="Сохранить профиль" Click="SaveProfile_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save20" /></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="22" Style="{StaticResource SurfaceCard}">
                                <StackPanel>
                                    <TextBlock Text="Изменить пароль" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Текущий пароль" /><PasswordBox x:Name="CurrentPasswordBox" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Новый пароль" /><PasswordBox x:Name="NewPasswordBox" />
                                    <ui:Button Margin="0,18,0,0" HorizontalAlignment="Left" Appearance="Secondary"
                                               Content="Изменить пароль" Click="ChangePassword_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Key20" /></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="22" Style="{StaticResource SurfaceCard}">
                                <StackPanel>
                                    <TextBlock Text="Изменить почту" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Новая почта" /><TextBox x:Name="NewEmailBox" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Текущий пароль" /><PasswordBox x:Name="EmailPasswordBox" />
                                    <ui:Button Margin="0,18,0,0" HorizontalAlignment="Left" Appearance="Secondary"
                                               Content="Изменить почту" Click="ChangeEmail_Click">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Mail20" /></ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="CreateEmployeePanel" Margin="0,18,0,24" Padding="22"
                                Style="{StaticResource SurfaceCard}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Добавить сотрудника" Style="{StaticResource SectionTitle}" />
                                <TextBlock Margin="0,5,0,8" Text="Временный пароль будет отправлен сотруднику по почте."
                                           Style="{StaticResource CaptionText}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,9,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Почта" /><TextBox x:Name="EmployeeEmailBox" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Имя" /><TextBox x:Name="EmployeeFirstNameBox" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Должность" /><TextBox x:Name="EmployeePositionBox" />
                                    </StackPanel>
                                    <StackPanel Margin="9,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Фамилия" /><TextBox x:Name="EmployeeLastNameBox" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Телефон" /><TextBox x:Name="EmployeePhoneBox" />
                                        <CheckBox x:Name="EmployeeAdministratorBox" Margin="0,24,0,0" Content="Администратор" />
                                    </StackPanel>
                                </UniformGrid>
                                <ui:Button Margin="0,18,0,0" HorizontalAlignment="Right" Appearance="Primary"
                                           Content="Создать учётную запись" Click="CreateEmployee_Click">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Add20" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="PasswordChangeOverlay" Grid.RowSpan="2" Panel.ZIndex="20" Background="#66000000" Visibility="Collapsed">
            <Border Width="430" Padding="30" Style="{StaticResource SurfaceCard}" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="44" Height="44" HorizontalAlignment="Left" CornerRadius="8" Background="#DCE9E6">
                        <ui:SymbolIcon Symbol="Key24" Foreground="#0F6B56" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="0,18,0,0" Text="Замените временный пароль" Style="{StaticResource PageTitle}" />
                    <TextBlock Margin="0,7,0,8" TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                               Text="Перед началом работы задайте постоянный пароль длиной не менее 10 символов." />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Временный пароль" /><PasswordBox x:Name="TemporaryPasswordBox" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Новый пароль" /><PasswordBox x:Name="RequiredNewPasswordBox" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Повторите новый пароль" /><PasswordBox x:Name="RequiredPasswordConfirmationBox" />
                    <TextBlock x:Name="RequiredPasswordError" Margin="0,12,0,0" Foreground="{StaticResource ErrorTextBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <ui:Button Margin="0,18,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Appearance="Primary" Content="Сохранить новый пароль" Click="CompletePasswordChange_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save20" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
