<Window x:Class="DieCutCatalog.Desktop.Views.JustCutPriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расчёт стоимости JustCut" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F7F9FC">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#526170" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Расчёт окончательной стоимости" FontSize="20" FontWeight="SemiBold" Foreground="#17365D" />
            <TextBlock x:Name="KnifeSummaryText" Margin="0,5,0,0" Foreground="#526170" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0" Padding="10" Background="#EDF5FC" Foreground="#245B91"
                       Text="Будет выполнен только расчёт цены с НДС. Заказ в JustCut не создаётся."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Высота ножа, мм" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="KnifeHeightBox" Text="0,442" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Толщина подложки, мм" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="SubstrateThicknessBox" Text="0,055" />
            </StackPanel>
            <StackPanel Grid.Row="2">
                <TextBlock Text="Угол заточки, градусов" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="AngleSharpeningBox" Text="90" />
            </StackPanel>
            <CheckBox Grid.Row="2" Grid.Column="2" x:Name="RushOrderBox" Content="Срочный расчёт"
                      VerticalAlignment="Center" />
        </Grid>

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,18,0,0">
            <CheckBox x:Name="EdgeUnder2MmBox" Margin="0,0,8,8" Content="Кромка менее 2 мм" />
            <CheckBox x:Name="AntiAdhesionCoatingBox" Margin="8,0,0,8" Content="Антиадгезионное покрытие" />
            <CheckBox x:Name="LaserHardeningBox" Margin="0,4,8,0" Content="Лазерная закалка" />
            <CheckBox x:Name="HardeningCoatingBox" Margin="8,4,0,0" Content="Упрочняющее покрытие" />
        </UniformGrid>

        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="Firebrick" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Width="100" MinHeight="34" Content="Отмена" IsCancel="True" />
            <Button Grid.Column="3" Width="130" MinHeight="34" Content="Рассчитать" IsDefault="True"
                    Background="#2F5F91" Foreground="White" Click="Calculate_Click" />
        </Grid>
    </Grid>
</Window>
