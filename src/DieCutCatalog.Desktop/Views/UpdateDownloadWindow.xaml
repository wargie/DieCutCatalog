<Window x:Class="DieCutCatalog.Desktop.Views.UpdateDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка обновления"
        Width="540" Height="290"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F8FA"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Загрузка обновления" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,6,0,0" Foreground="#616161" />

        <Grid Grid.Row="2" Margin="0,26,0,0">
            <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100"
                         Foreground="#0F6CBD" Background="#E1E5EA" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SizeText" Foreground="#616161" Text="Подключение к серверу..." />
            <TextBlock x:Name="PercentageText" Grid.Column="1" FontWeight="SemiBold" Text="0 %" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,16,0,0" TextWrapping="Wrap"
                   Foreground="#616161" Text="Пожалуйста, не закрывайте приложение." />

        <Button x:Name="CancelButton" Grid.Row="5" Width="110" Height="34"
                HorizontalAlignment="Right" Content="Отмена" Click="CancelButton_Click" />
    </Grid>
</Window>
