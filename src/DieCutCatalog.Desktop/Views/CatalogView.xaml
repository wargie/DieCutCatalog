<UserControl x:Class="DieCutCatalog.Desktop.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,9,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="ImportExcelButton" Margin="0,0,8,0" Appearance="Secondary"
                           Content="Импорт Excel" Visibility="Collapsed" Click="ImportExcel_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUpload20" /></ui:Button.Icon>
                </ui:Button>
                <ui:Button Appearance="Primary" Content="Новый нож" Click="NewDieCut_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Add20" /></ui:Button.Icon>
                </ui:Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Каталог ножей" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="CatalogSummary" Margin="0,5,0,0" Style="{StaticResource CaptionText}" Text="Загрузка данных..." />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,18,0,14" Padding="12" Background="#80FFFFFF"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="210" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource CompactTextBox}"
                         ToolTip="Поиск по номеру, материалу, фигуре и комментарию" KeyDown="SearchBox_KeyDown" />
                <ComboBox x:Name="EquipmentFilter" Grid.Column="2" Style="{StaticResource CompactComboBox}" ToolTip="Оборудование" />
                <ComboBox x:Name="MaterialFilter" Grid.Column="4" Style="{StaticResource CompactComboBox}" ToolTip="Материал" />
                <ComboBox x:Name="FigureFilter" Grid.Column="6" Style="{StaticResource CompactComboBox}" ToolTip="Фигура" />
                <ui:Button Grid.Column="8" Width="38" Height="34" Padding="0" Appearance="Primary"
                           ToolTip="Применить поиск и фильтры" Click="ApplyFilters_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Search20" /></ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="EditorColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SurfaceCard}" ClipToBounds="True">
                <DataGrid x:Name="DieCutsGrid"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0" EnableRowVirtualization="True"
                          SelectionChanged="DieCutsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="82" />
                        <DataGridTextColumn Header="Оборудование" Binding="{Binding Equipment}" Width="125" />
                        <DataGridTextColumn Header="shaft" Binding="{Binding Shaft}" Width="62" />
                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="62" />
                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="62" />
                        <DataGridTextColumn Header="streams" Binding="{Binding Streams}" Width="68" />
                        <DataGridTextColumn Header="repeats" Binding="{Binding Repeats}" Width="68" />
                        <DataGridTextColumn Header="x" Binding="{Binding GapXText}" Width="88" />
                        <DataGridTextColumn Header="y" Binding="{Binding GapYText}" Width="88" />
                        <DataGridTextColumn Header="material" Binding="{Binding Material}" Width="150" />
                        <DataGridTextColumn Header="H" Binding="{Binding H}" Width="62" />
                        <DataGridTextColumn Header="figure" Binding="{Binding Figure}" Width="110" />
                        <DataGridTextColumn Header="comments" Binding="{Binding Comments}" Width="180" />
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="88" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="EditorPanel" Grid.Column="2" Style="{StaticResource SurfaceCard}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="18,14,12,8">
                        <ui:Button DockPanel.Dock="Right" Width="34" Height="34" Padding="0" Appearance="Transparent"
                                   ToolTip="Закрыть карточку" Click="CloseEditor_Click">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss20" /></ui:Button.Icon>
                        </ui:Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="EditorTitle" Text="Карточка ножа" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Поля соответствуют структуре каталога Excel" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Margin="0,4,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,5,18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="№" />
                                        <TextBox x:Name="NumberBox" Style="{StaticResource CompactTextBox}" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="shaft" />
                                        <TextBox x:Name="ShaftBox" Style="{StaticResource CompactTextBox}" ToolTip="Только целое число" PreviewTextInput="ShaftBox_PreviewTextInput" TextChanged="CalculationInput_TextChanged" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="X" />
                                        <TextBox x:Name="XBox" Style="{StaticResource CompactTextBox}" TextChanged="CalculationInput_TextChanged" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="streams" />
                                        <TextBox x:Name="StreamsBox" Style="{StaticResource CompactTextBox}" TextChanged="CalculationInput_TextChanged" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="x" />
                                        <TextBox x:Name="GapXBox" Style="{StaticResource ReadOnlyTextBox}" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="H" />
                                        <TextBox x:Name="HBox" Style="{StaticResource CompactTextBox}" TextChanged="CalculationInput_TextChanged" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="Дата" />
                                        <DatePicker x:Name="DateBox" MinHeight="34" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="Оборудование" />
                                        <ComboBox x:Name="EquipmentBox" Style="{StaticResource CompactComboBox}" IsEditable="True" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="Y" />
                                        <TextBox x:Name="YBox" Style="{StaticResource CompactTextBox}" TextChanged="CalculationInput_TextChanged" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="repeats" />
                                        <TextBox x:Name="RepeatsBox" Style="{StaticResource CompactTextBox}" TextChanged="CalculationInput_TextChanged" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="y" />
                                        <TextBox x:Name="GapYBox" Style="{StaticResource ReadOnlyTextBox}" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="material" />
                                        <ComboBox x:Name="MaterialBox" Style="{StaticResource CompactComboBox}" IsEditable="True" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="figure" />
                                        <ComboBox x:Name="FigureBox" Style="{StaticResource CompactComboBox}" IsEditable="True" />
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="Статус" />
                                        <ComboBox x:Name="StatusBox" Style="{StaticResource CompactComboBox}" DisplayMemberPath="Name" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource EditorLabel}" Text="comments" />
                                <TextBox x:Name="CommentsBox" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="18,12,18,14">
                        <TextBlock x:Name="EditorStatus" VerticalAlignment="Center" Foreground="{StaticResource SuccessTextBrush}"
                                   TextWrapping="Wrap" />
                        <ui:Button x:Name="SaveButton" DockPanel.Dock="Right" Appearance="Primary"
                                   Content="Сохранить" Click="SaveDieCut_Click">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Save20" /></ui:Button.Icon>
                        </ui:Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button x:Name="PreviousPageButton" Width="36" Height="34" Padding="0" Appearance="Secondary"
                           ToolTip="Предыдущая страница" Click="PreviousPage_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ChevronLeft20" /></ui:Button.Icon>
                </ui:Button>
                <TextBlock x:Name="PageText" Margin="14,0" VerticalAlignment="Center" />
                <ui:Button x:Name="NextPageButton" Width="36" Height="34" Padding="0" Appearance="Secondary"
                           ToolTip="Следующая страница" Click="NextPage_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ChevronRight20" /></ui:Button.Icon>
                </ui:Button>
            </StackPanel>
            <TextBlock x:Name="CatalogError" Foreground="{StaticResource ErrorTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
