<UserControl x:Class="DieCutCatalog.Desktop.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="EditorSection" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#DCE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="EditorSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#315E91" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EquipmentTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" CornerRadius="4,4,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#F3F6F9" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#EDF4FC" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#315E91" />
                                <Setter Property="Foreground" Value="#214F82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition x:Name="EditorColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid Margin="20,18,14,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="ImportExcelButton" Margin="0,0,8,0" Appearance="Secondary"
                               Content="Импорт Excel" Visibility="Collapsed" Click="ImportExcel_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowUpload20" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button x:Name="ImportPdfButton" Margin="0,0,8,0" Appearance="Secondary"
                               Content="Импорт PDF" Click="ImportPdf_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="DocumentPdf24" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Primary" Content="Новый нож" Click="NewDieCut_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Add20" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Каталог ножей" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="CatalogSummary" Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                               Text="Загрузка данных..." />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Margin="0,14,0,0" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ListBox x:Name="EquipmentTabs" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource EquipmentTabItemStyle}"
                             SelectionChanged="EquipmentTabs_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Margin="0,12,0,14" Padding="10" Background="#FAFBFC"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="160" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource CompactTextBox}"
                             ToolTip="Поиск по номеру ножа, заказу JC, материалу и комментарию"
                             KeyDown="SearchBox_KeyDown" />
                    <ComboBox x:Name="MaterialFilter" Grid.Column="2" Style="{StaticResource CompactComboBox}"
                              ToolTip="Материал" />
                    <ComboBox x:Name="FigureFilter" Grid.Column="4" Style="{StaticResource CompactComboBox}"
                              ToolTip="Фигура" />
                    <ui:Button Grid.Column="6" Width="38" Height="34" Padding="0" Appearance="Primary"
                               ToolTip="Применить поиск и фильтры" Click="ApplyFilters_Click">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Search20" /></ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DieCutsGrid"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" EnableRowVirtualization="True"
                              HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="DieCutsGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding RowBackground}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="72" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120" />
                            <DataGridTextColumn Header="Вал" Binding="{Binding Shaft}" Width="62" />
                            <DataGridTextColumn Header="L" Binding="{Binding XText}" Width="62" />
                            <DataGridTextColumn Header="B" Binding="{Binding YText}" Width="62" />
                            <DataGridTextColumn Header="Ручьи" Binding="{Binding Streams}" Width="68" />
                            <DataGridTextColumn Header="Эт. в ручье" Binding="{Binding Repeats}" Width="92" />
                            <DataGridTextColumn Header="A1" Binding="{Binding GapXText}" Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGapXNegative}" Value="True">
                                                <Setter Property="Foreground" Value="#C42B1C" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="A2" Binding="{Binding GapYText}" Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGapYNegative}" Value="True">
                                                <Setter Property="Foreground" Value="#C42B1C" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="140" />
                            <DataGridTextColumn Header="Ширина материала" Binding="{Binding HText}" Width="128" />
                            <DataGridTextColumn Header="Фигура" Binding="{Binding Figure}" Width="118" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="86" />
                            <DataGridTextColumn Header="Оборудование" Binding="{Binding Equipment}" Width="120" />
                            <DataGridTextColumn Header="Заказ JC" Binding="{Binding JcOrderNumber}" Width="95" />
                            <DataGridTextColumn Header="Обороты" Binding="{Binding RevolutionsText}" Width="90" />
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comments}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                            Background="#FCFCFD">
                        <DockPanel Margin="12,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="PreviousPageButton" Width="32" Height="30" Padding="0"
                                           Appearance="Secondary" ToolTip="Предыдущая страница"
                                           Click="PreviousPage_Click">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ChevronLeft20" /></ui:Button.Icon>
                                </ui:Button>
                                <TextBlock x:Name="PageText" Margin="12,0" VerticalAlignment="Center" FontSize="12" />
                                <ui:Button x:Name="NextPageButton" Width="32" Height="30" Padding="0"
                                           Appearance="Secondary" ToolTip="Следующая страница"
                                           Click="NextPage_Click">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ChevronRight20" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                            <TextBlock Text="Выберите нож, чтобы открыть карточку" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock x:Name="CatalogError" Grid.Row="4" Margin="0,9,0,0"
                       Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" />
        </Grid>

        <Border x:Name="EditorPanel" Grid.Column="1" Background="#FCFCFD"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                        Background="{StaticResource SurfaceBrush}">
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="EditorTitle" Text="Карточка ножа"
                                           FontSize="18" FontWeight="SemiBold" />
                                <Border x:Name="EditorStatusBadge" Margin="10,0,0,0" Padding="10,3"
                                        CornerRadius="10" Background="#E7F1FF" Visibility="Collapsed">
                                    <TextBlock x:Name="EditorStatusBadgeText" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#1769AA" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" Text="Редактирование параметров"
                                       FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Width="34" Height="34" Padding="0"
                                   Appearance="Transparent" ToolTip="Закрыть карточку"
                                   Click="CloseEditor_Click">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss20" /></ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="EditorScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,14,20,18">
                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <Border Height="36" Padding="12,0" Background="#F6F8FB"
                                        BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
                                    <TextBlock Text="ОСНОВНЫЕ ДАННЫЕ" Style="{StaticResource EditorSectionTitle}" />
                                </Border>
                                <Grid Margin="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Номер ножа" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource EditorLabel}" Text="Оборудование" />
                                    <TextBox x:Name="NumberBox" Grid.Row="1" Style="{StaticResource CompactTextBox}" />
                                    <ComboBox x:Name="EquipmentBox" Grid.Row="1" Grid.Column="2"
                                              Style="{StaticResource CompactComboBox}" />

                                    <TextBlock Grid.Row="3" Style="{StaticResource EditorLabel}" Text="Номер заказа JC" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource EditorLabel}" Text="Материал" />
                                    <TextBox x:Name="JcOrderNumberBox" Grid.Row="4" Style="{StaticResource CompactTextBox}" />
                                    <ComboBox x:Name="MaterialBox" Grid.Row="4" Grid.Column="2"
                                              Style="{StaticResource CompactComboBox}" />

                                    <TextBlock Grid.Row="6" Style="{StaticResource EditorLabel}" Text="Фигура" />
                                    <ComboBox x:Name="FigureBox" Grid.Row="7" Grid.ColumnSpan="3"
                                              Style="{StaticResource CompactComboBox}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <Border Height="36" Padding="12,0" Background="#F6F8FB"
                                        BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
                                    <TextBlock Text="ГАБАРИТЫ НОЖА" Style="{StaticResource EditorSectionTitle}" />
                                </Border>
                                <Grid Margin="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource EditorLabel}" Text="Ширина этикетки L, мм" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource EditorLabel}" Text="Длина этикетки B, мм" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource EditorLabel}" Text="Ширина материала, мм" />
                                    <TextBox x:Name="XBox" Grid.Row="1" Style="{StaticResource CompactTextBox}"
                                             TextChanged="CalculationInput_TextChanged" />
                                    <TextBox x:Name="YBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource CompactTextBox}"
                                             TextChanged="CalculationInput_TextChanged" />
                                    <TextBox x:Name="HBox" Grid.Row="1" Grid.Column="4" Style="{StaticResource CompactTextBox}"
                                             TextChanged="CalculationInput_TextChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <Border Height="36" Padding="12,0" Background="#F6F8FB"
                                        BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
                                    <TextBlock Text="РАСКЛАДКА" Style="{StaticResource EditorSectionTitle}" />
                                </Border>
                                <StackPanel Margin="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="Вал (shaft)" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource EditorLabel}" Text="Ручьи" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource EditorLabel}" Text="Этикеток в ручье" />
                                        <TextBox x:Name="ShaftBox" Grid.Row="1" Style="{StaticResource CompactTextBox}"
                                                 ToolTip="Только целое число" PreviewTextInput="ShaftBox_PreviewTextInput"
                                                 TextChanged="CalculationInput_TextChanged" />
                                        <TextBox x:Name="StreamsBox" Grid.Row="1" Grid.Column="2"
                                                 Style="{StaticResource CompactTextBox}"
                                                 TextChanged="CalculationInput_TextChanged" />
                                        <TextBox x:Name="RepeatsBox" Grid.Row="1" Grid.Column="4"
                                                 Style="{StaticResource CompactTextBox}"
                                                 TextChanged="CalculationInput_TextChanged" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource EditorLabel}" Text="Расстояние между ручьями, мм" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource EditorLabel}"
                                                   Text="Радиус скругления этикетки, мм" />
                                        <TextBox x:Name="GrooveSpacingBox" Grid.Row="1" Style="{StaticResource CompactTextBox}"
                                                 TextChanged="CalculationInput_TextChanged" />
                                        <TextBox x:Name="LabelCornerRadiusBox" Grid.Row="1" Grid.Column="2"
                                                 Style="{StaticResource CompactTextBox}"
                                                 TextChanged="CalculationInput_TextChanged" />
                                    </Grid>
                                    <TextBlock Margin="0,12,0,0" Text="Расчётные значения" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#315E91" />
                                    <Border Margin="0,6,0,0" Padding="10" CornerRadius="4" Background="#F8FAFC"
                                            BorderBrush="#E2E7EC" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource EditorLabel}" Text="A1" ToolTip="A1 = (ширина материала − L × ручьи − расстояние × (ручьи − 1)) / 1000" />
                                                <TextBox x:Name="GapXBox" Style="{StaticResource ReadOnlyTextBox}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource EditorLabel}" Text="A2" ToolTip="A2 = (окружность вала / этикеток в ручье − B) / 1000" />
                                                <TextBox x:Name="GapYBox" Style="{StaticResource ReadOnlyTextBox}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource EditorSection}">
                            <StackPanel>
                                <Border Height="36" Padding="12,0" Background="#F6F8FB"
                                        BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
                                    <TextBlock Text="СОСТОЯНИЕ И ПРИМЕЧАНИЯ" Style="{StaticResource EditorSectionTitle}" />
                                </Border>
                                <StackPanel Margin="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="Статус" />
                                            <ComboBox x:Name="StatusBox" Style="{StaticResource CompactComboBox}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource EditorLabel}" Text="Дата изменения" />
                                            <DatePicker x:Name="DateBox" MinHeight="34" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,12,0,5" Style="{StaticResource EditorLabel}" Text="Комментарий" />
                                    <TextBox x:Name="CommentsBox" MinHeight="64" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="DrawingSection" Style="{StaticResource EditorSection}" Visibility="Collapsed">
                            <StackPanel>
                                <Border Height="36" Padding="12,0" Background="#F6F8FB"
                                        BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
                                    <TextBlock Text="ЧЕРТЁЖ" Style="{StaticResource EditorSectionTitle}" />
                                </Border>
                                <StackPanel Margin="12">
                                    <TextBlock x:Name="DocumentNameText" Text="PDF не прикреплён"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <UniformGrid Columns="4" Margin="0,10,0,0">
                                        <ui:Button x:Name="UploadPdfButton" Margin="0,0,4,0" Appearance="Secondary"
                                                   Content="Загрузить" Click="UploadPdf_Click" />
                                        <ui:Button x:Name="GeneratePdfButton" Margin="4,0" Appearance="Secondary"
                                                   Content="Создать PDF" Click="GeneratePdf_Click" />
                                        <ui:Button x:Name="OpenPdfButton" Margin="4,0" Appearance="Primary"
                                                   Content="Открыть" Click="OpenPdf_Click" IsEnabled="False" />
                                        <ui:Button x:Name="DownloadPdfButton" Margin="4,0,0,0" Appearance="Secondary"
                                                   Content="Скачать" Click="DownloadPdf_Click" IsEnabled="False" />
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="OperationsPanel" Style="{StaticResource EditorSection}" Visibility="Collapsed">
                            <StackPanel>
                                <Border Height="36" Padding="12,0" Background="#F6F8FB"
                                        BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
                                    <TextBlock Text="УЧЁТ ТИРАЖА" Style="{StaticResource EditorSectionTitle}" />
                                </Border>
                                <StackPanel Margin="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Тираж, шт" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock x:Name="MileageText" Margin="0,3,0,0" FontSize="18"
                                                       FontWeight="SemiBold" Foreground="#147D73" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Пробег, м" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock x:Name="RunLengthMetersText" Margin="0,3,0,0" FontSize="18"
                                                       FontWeight="SemiBold" Foreground="#147D73" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Обороты" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock x:Name="RevolutionsText" Margin="0,3,0,0" FontSize="18"
                                                       FontWeight="SemiBold" Foreground="#147D73" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ResourceStateText" FontWeight="SemiBold" />
                                        <TextBlock x:Name="GenerationText" Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </Grid>
                                    <ProgressBar x:Name="ResourceProgressBar" Height="8" Margin="0,6,0,0" Minimum="0" />
                                    <TextBlock x:Name="LifetimeUsageText" Margin="0,6,0,0" FontSize="11"
                                               TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <RadioButton x:Name="QuantityModeRadio" Content="Тираж, шт" IsChecked="True"
                                                         Checked="UsageMode_Checked" />
                                            <TextBox x:Name="CirculationBox" Margin="0,5,0,0"
                                                     Style="{StaticResource CompactTextBox}"
                                                     ToolTip="Введите целое количество экземпляров"
                                                     PreviewTextInput="PositiveInteger_PreviewTextInput" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <RadioButton x:Name="RunLengthModeRadio" Content="Пробег, м"
                                                         Checked="UsageMode_Checked" />
                                            <TextBox x:Name="RunLengthInputBox" Margin="0,5,0,0"
                                                     Style="{StaticResource CompactTextBox}" IsEnabled="False"
                                                     ToolTip="Введите пробег в погонных метрах" />
                                        </StackPanel>
                                    </Grid>
                                    <ui:Button x:Name="AddCirculationButton" Margin="0,8,0,0"
                                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                               Appearance="Primary" Content="Добавить"
                                               Click="AddCirculation_Click" />
                                    <UniformGrid Columns="3" Margin="0,10,0,0">
                                        <ui:Button x:Name="InstallReplacementButton" Margin="0,0,4,0" Appearance="Secondary"
                                                   Content="Установить новый" Click="InstallReplacement_Click" />
                                        <ui:Button x:Name="RetireButton" Margin="4,0" Appearance="Secondary"
                                                   Foreground="#B42318" Content="Списать нож"
                                                   Click="RetireDieCut_Click" />
                                        <ui:Button x:Name="DeleteButton" Margin="4,0,0,0" Appearance="Secondary"
                                                   Foreground="#B42318" Content="Удалить нож"
                                                   Click="DeleteDieCut_Click" />
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="EventsSection" Style="{StaticResource EditorSection}" Visibility="Collapsed">
                            <StackPanel>
                                <Border Height="36" Padding="12,0" Background="#F6F8FB"
                                        BorderBrush="#DCE3EA" BorderThickness="0,0,0,1">
                                    <TextBlock Text="ЖУРНАЛ НОЖА" Style="{StaticResource EditorSectionTitle}" />
                                </Border>
                                <ListView x:Name="EventsList" MinHeight="90" MaxHeight="210" Margin="8"
                                          BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DateText}" FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding EmployeeName}" Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                    <DockPanel Margin="20,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Margin="0,0,10,0" Appearance="Secondary"
                                       Content="Отмена" Click="CloseEditor_Click" />
                            <ui:Button x:Name="SaveButton" Appearance="Primary"
                                       Content="Сохранить" Click="SaveDieCut_Click">
                                <ui:Button.Icon><ui:SymbolIcon Symbol="Save20" /></ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                        <TextBlock x:Name="EditorStatus" VerticalAlignment="Center"
                                   Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>