<Window x:Class="DieCutCatalog.Desktop.Views.ReferencePositionActionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="520" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 Background="{StaticResource AppBackgroundBrush}"
                 WindowStyle="SingleBorderWindow" UseLayoutRounding="True">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="HintText" Margin="0,6,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Название позиции" Margin="0,0,0,6" FontWeight="SemiBold" />
            <TextBox x:Name="NameBox" MinHeight="38" Padding="10,7" />
        </StackPanel>
        <StackPanel x:Name="DestinationPanel" Grid.Row="4">
            <TextBlock Text="Раздел назначения" Margin="0,0,0,6" FontWeight="SemiBold" />
            <ComboBox x:Name="DestinationBox" MinHeight="38" Padding="8,5"
                      DisplayMemberPath="DisplayName" />
        </StackPanel>
        <TextBlock x:Name="ValidationText" Grid.Row="5" VerticalAlignment="Bottom"
                   Foreground="{StaticResource ErrorTextBrush}" Visibility="Collapsed" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button MinWidth="94" Margin="0,0,10,0" Content="Отмена"
                       Appearance="Secondary" Click="Cancel_Click" />
            <ui:Button x:Name="ConfirmButton" MinWidth="120" Content="Продолжить"
                       Appearance="Primary" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
